# Generate with `openssl rand -hex 16`; keep it stable to decrypt stored credentials.
ENCRYPTION_KEY=
# Must match the Verify Token entered in Meta webhook configuration. Replace before production.
VERIFY_TOKEN=praise123

# Secret belonging to the Veylo Meta app; used to verify webhook signatures.
VEYLO_META_APP_ID=1114951657664033
VEYLO_META_APP_SECRET=

# Paynow merchant account used by Veylo to collect subscription payments.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
BASE_URL=https://your-domain.example
